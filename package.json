    "test": "bun test test/core.test.ts",
    "test:live": "LIVE=1 bun test test/live-cli.test.ts",
    "test:e2e": "E2E=1 bun test test/e2e/chrome.test.ts",
    "web": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:preview": "bun run --cwd web preview"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  }
}
